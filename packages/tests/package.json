{
    "name": "@driftlock/tests",
    "version": "0.1.0",
    "private": true,
    "main": "./index.ts",
    "types": "./index.ts",
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext .ts",
        "test": "bun test",
        "test:unit": "bun test unit/",
        "test:integration": "bun test integration/",
        "test:e2e": "bun test e2e/",
        "test:watch": "bun test --watch",
        "test:coverage": "bun run coverageCheck.ts"
    },
    "dependencies": {
        "@driftlock/agent": "workspace:*",
        "@driftlock/core": "workspace:*",
        "@driftlock/diff": "workspace:*",
        "@driftlock/git": "workspace:*",
        "@driftlock/parser": "workspace:*",
        "@driftlock/sandbox": "workspace:*",
        "@driftlock/webhookCapture": "workspace:*"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.3.0"
    }
}
