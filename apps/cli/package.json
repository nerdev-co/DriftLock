{
    "name": "@driftlock/cli",
    "version": "0.1.0",
    "private": true,
    "main": "./index.ts",
    "types": "./index.ts",
    "type": "module",
    "bin": {
        "driftlock": "./dist/index.js"
    },
    "scripts": {
        "build": "bun build ./index.ts --outdir ./dist --target node --external @driftlock/* --external ssh2 --external cpu-features",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext .ts"
    },
    "dependencies": {
        "@driftlock/agent": "workspace:*",
        "@driftlock/core": "workspace:*",
        "@driftlock/diff": "workspace:*",
        "@driftlock/git": "workspace:*",
        "@driftlock/aiFix": "workspace:*",
        "@driftlock/parser": "workspace:*",
        "@driftlock/pipeline": "workspace:*",
        "@driftlock/sandbox": "workspace:*",
        "@driftlock/webhookCapture": "workspace:*",
        "chalk": "^5.3.0",
        "commander": "^12.0.0",
        "inquirer": "^9.2.0",
        "ora": "^8.0.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.3.0"
    }
}
